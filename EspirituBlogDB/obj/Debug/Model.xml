		<Element Type="SqlProcedure" Name="[dbo].[spPosts_List]">
			<Property Name="BodyScript">
				<Value><![CDATA[
BEGIN
    SET NOCOUNT ON;

    SELECT
        p.Id,
        p.Title,
        p.Body,
        p.DateCreated,
        u.UserName,
        u.FirstName,
        u.LastName
    FROM dbo.Posts p
    INNER JOIN dbo.Users u ON p.UserId = u.Id
    ORDER BY p.DateCreated DESC;
END]]></Value>
